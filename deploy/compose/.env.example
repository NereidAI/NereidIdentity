# NereidIdentity development stack overrides.
# Copy to .env for non-default local settings; all values below are the
# built-in defaults used by docker-compose.yml.

# Container images (public upstream defaults; offline hosts pull through a
# node-level registry mirror, see the NereidOverview mirror guide). Override
# only when using a local mirror or a different tag.
PG_IMAGE=postgres:16-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.1
BOOTSTRAP_IMAGE=ghcr.io/nereidai/nereididentity-bootstrap:0.0.0-dev

# Keycloak master administrator (dev only)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# Secret of the nereidsphere-admin client; must match realm JSON
# (dev default "changeme-admin"). Used by the bootstrap profile.
KC_ADMIN_CLIENT_SECRET=changeme-admin

# Keycloak database
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak

# Host-published Keycloak HTTP port; product dev configs point at
# http://localhost:8090/realms/nereidai
KC_HOST_PORT=8090
